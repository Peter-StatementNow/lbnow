# Referral form email delivery (lib/email/send-referral-notification.ts).
# The referral form is inert (submissions fail with a clear error) until
# all three of these are set. Get a Resend API key and a verified
# sending domain/address at https://resend.com.
RESEND_API_KEY=
REFERRAL_NOTIFICATION_EMAIL=
REFERRAL_NOTIFICATION_FROM_EMAIL=
